#!/bin/sh

echo "🔍 Запуск Detekt auto-correct перед коммитом..."

# Получаем список измененных .kt файлов, добавленных в индекс (staged)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.kt$')

if [ -z "$STAGED_FILES" ]; then
    echo "✅ Измененных Kotlin-файлов нет. Пропускаем проверку."
    exit 0
fi

# Запускаем detekt с автоисправлением
./gradlew detekt --auto-correct

# Сохраняем код возврата Gradle
EXIT_CODE=$?

# Добавляем автоматически исправленные файлы обратно в текущий коммит
echo "$STAGED_FILES" | xargs git add

if [ $EXIT_CODE -ne 0 ]; then
    echo "❌ Detekt нашел ошибки, которые не удалось исправить автоматически. Коммит отменен."
    exit $EXIT_CODE
fi

echo "✅ Проверка Detekt пройдена успешно!"
exit 0
