-- Таблица привычек
CREATE TABLE habit_table (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    category INTEGER NOT NULL,  -- 0=TRANSPORT, 1=WASTE, 2=WATER, 3=PLASTIC
    is_completed INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    UNIQUE(title, category)
);

-- Индекс для быстрого поиска по категории
CREATE INDEX habit_category_idx ON habit_table(category);

-- Query: Получить все привычки (отсортировано по дате)
selectAllHabits:
    SELECT id, title, category, is_completed, created_at, updated_at
    FROM habit_table
    ORDER BY created_at DESC;

-- Query: Получить привычки по категории
selectHabitsByCategory:
    SELECT id, title, category, is_completed, created_at, updated_at
    FROM habit_table
    WHERE category = ?
    ORDER BY created_at DESC;

-- Query: Получить одну привычку по ID
selectHabit:
    SELECT id, title, category, is_completed, created_at, updated_at
    FROM habit_table
    WHERE id = ?;

-- Query: Удалить привычку по ID
deleteHabit:
    DELETE FROM habit_table WHERE id = ?;

-- Query: Обновить привычку
updateHabit:
    UPDATE habit_table
    SET title = ?, category = ?, is_completed = ?, updated_at = ?
    WHERE id = ?;

-- Query: Вставить новую привычку
insertHabit:
    INSERT OR IGNORE INTO habit_table (title, category, is_completed, created_at, updated_at)
    VALUES (?, ?, ?, ?, ?);